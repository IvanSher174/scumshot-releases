[Unit]
Description=Publish signed SCUMshot server status
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
EnvironmentFile=/etc/scumshot-status.env
UnsetEnvironment=WARDEN_API_KEY STATUS_SIGNING_KEY GH_TOKEN
LoadCredential=warden-api-key:/etc/scumshot-status/warden-api-key
LoadCredential=status-signing-key:/etc/scumshot-status/status-signing-key
LoadCredential=github-token:/etc/scumshot-status/github-token
ExecStart=/usr/bin/node /opt/scumshot-status/publish-status.cjs
TimeoutStartSec=180
TimeoutStopSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0077
LimitCORE=0
